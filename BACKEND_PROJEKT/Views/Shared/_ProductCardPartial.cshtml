@model BACKEND_PROJEKT.Models.Product

<div class="product-item mb-50">
    <div class="product-thumb">
        <a href="#">
            <img src="~/assets/img/product/@Model.Image" alt="@Model.Name" />
        </a>
    </div>
    <div class="product-content">
        <h5 class="product-name">
            <a href="#">@Model.Name</a>
        </h5>
        <div class="price-box">
            <span class="price-regular">$@Model.Price.ToString("0.00")</span>
            @if (Model.OldPrice.HasValue)
            {
                <span class="price-old"><del>$@Model.OldPrice.Value.ToString("0.00")</del></span>
            }
        </div>
        <div class="product-action-link">
            <a href="#" data-bs-toggle="tooltip" title="Wishlist">
                <i class="ion-android-favorite-outline"></i>
            </a>
            <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@Model.Id" data-bs-toggle="tooltip" title="Add To Cart">
                <i class="ion-bag"></i>
            </a>
            <a href="#" data-bs-toggle="modal" data-bs-target="#quick_view">
                <span data-bs-toggle="tooltip" title="Quick View"><i class="ion-ios-eye-outline"></i></span>
            </a>
        </div>
    </div>
</div>
