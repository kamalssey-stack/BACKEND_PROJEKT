@using BACKEND_PROJEKT.ViewModels
@model RegisterVM
@{
    ViewData["Title"] = "Register";
}

<div class="breadcrumb-area bg-img" data-bg="/assets/img/banner/breadcrumb-banner.jpg">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcrumb-wrap text-center">
                    <nav aria-label="breadcrumb">
                        <h1 class="breadcrumb-title">Register</h1>
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Register</li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="login-register-wrapper section-padding">
    <div class="container">
        <div class="member-area-from-wrap">
            <div class="row justify-content-center">
                <div class="col-lg-6">
                    <div class="login-reg-form-wrap signup-form">
                        <h2>Singup Form</h2>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <form asp-controller="Account" asp-action="Register" method="post">
                            <div class="single-input-item">
                                <input asp-for="FullName" placeholder="Full Name" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>
                            <div class="single-input-item">
                                <input asp-for="UserName" placeholder="Username" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>
                            <div class="single-input-item">
                                <input asp-for="Email" placeholder="Enter your Email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="single-input-item">
                                        <input asp-for="Password" placeholder="Enter your Password" />
                                        <span asp-validation-for="Password" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="single-input-item">
                                        <input asp-for="ConfirmPassword" placeholder="Repeat your Password" />
                                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="single-input-item">
                                <a asp-controller="Account" asp-action="Login" class="forget-pwd mb-3 d-block">Already have an account? Login</a>
                                <button type="submit" class="btn btn-sqr">Register</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
