@using BACKEND_PROJEKT.ViewModels
@model HomeVM
@{
    ViewData["Title"] = "Juan - Shoes Store";
}

<main>
    <section class="hero-slider-area">
        <div class="hero-slider-active slick-arrow-style slick-dot-style">
            @foreach (var slider in Model.Sliders)
            {
                <div class="hero-single-slide hero-overlay" style="background-image: url('/assets/img/slider/@slider.Image');">
                    <div class="container">
                        <div class="row">
                            <div class="col-12">
                                <div class="hero-slider-content">
                                    <h5 class="slide-desc">@slider.Subtitle</h5>
                                    <h1 class="slide-title">@slider.Title</h1>
                                    <p class="slide-content">@slider.Description</p>
                                    <a href="#" class="btn btn-hero">SHOP NOW</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="service-policy-area section-padding">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="policy-wrapper">
                        @foreach (var feature in Model.ServiceFeatures)
                        {
                            <div class="single-policy d-flex align-items-center">
                                <div class="policy-icon">
                                    <img src="~/assets/img/icon/policy-@(feature.Id).png" alt="@feature.Title" />
                                </div>
                                <div class="policy-content">
                                    <h5 class="policy-title">@feature.Title</h5>
                                    <p class="policy-desc">@feature.SubTitle</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="our-product section-padding">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="section-title text-center">
                        <h2 class="title">Our Product</h2>
                        <p class="sub-title">Lorem ipsum dolor sit amet consectetur adipisicing</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="product-carousel-4 slick-row-10 slick-arrow-style">
                        @foreach (var product in Model.Products)
                        {
                            <partial name="_ProductCardPartial" model="product" />
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="banner-statistic-area">
        <div class="container">
            <div class="row mtn-30">
                <div class="col-md-6">
                    <div class="img-container mt-30">
                        <a href="#">
                            <img src="~/assets/img/banner/banner-1.jpg" alt="banner-image" />
                        </a>
                        <div class="banner-text">
                            <h5 class="banner-subtitle">sports shoes</h5>
                            <h3 class="banner-title">20% Off<br />For Sports men</h3>
                            <a href="#" class="btn btn-text">Shop Now</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="img-container mt-30">
                        <a href="#">
                            <img src="~/assets/img/banner/banner-2.jpg" alt="banner-image" />
                        </a>
                        <div class="banner-text">
                            <h5 class="banner-subtitle">sports shoes</h5>
                            <h3 class="banner-title">20% Off<br />For Sports men</h3>
                            <a href="#" class="btn btn-text">Shop Now</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="brand-area section-padding">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="brand-active-carousel">
                        <div class="brand-item">
                            <a href="#">
                                <img src="~/assets/img/brand/br1.png" alt="brand image" />
                            </a>
                        </div>
                        <div class="brand-item">
                            <a href="#">
                                <img src="~/assets/img/brand/br2.png" alt="brand image" />
                            </a>
                        </div>
                        <div class="brand-item">
                            <a href="#">
                                <img src="~/assets/img/brand/br3.png" alt="brand image" />
                            </a>
                        </div>
                        <div class="brand-item">
                            <a href="#">
                                <img src="~/assets/img/brand/br4.png" alt="brand image" />
                            </a>
                        </div>
                        <div class="brand-item">
                            <a href="#">
                                <img src="~/assets/img/brand/br5.png" alt="brand image" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
